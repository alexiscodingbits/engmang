generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  TEXT
  IMAGE
  LINK
  QUESTION
}

enum ModuleSection {
  NOTES
  QUESTIONS
  UPLOADED_WORK
}

model User {
  id               String     @id  // Supabase Auth UUID — set explicitly on create
  name             String
  email            String     @unique
  year             Int        @default(1)
  bio              String?
  avatarUrl        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  posts            Post[]
  comments         Comment[]
  votes            Vote[]
  bookmarks        Bookmark[]
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
}

model Post {
  id          String         @id @default(cuid())
  title       String
  body        String?
  type        PostType       @default(TEXT)
  imageUrl    String?
  linkUrl     String?
  // Module posts only
  moduleCode  String?
  moduleYear  Int?
  section     ModuleSection?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  author      User           @relation(fields: [authorId], references: [id])
  authorId    String
  comments    Comment[]
  votes       Vote[]
  bookmarks   Bookmark[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
}

model Vote {
  id        String   @id @default(cuid())
  value     Int      // 1 = upvote, -1 = downvote
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@unique([userId, postId])
}

model Message {
  id         String   @id @default(cuid())
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
}

model FaqItem {
  id         String   @id @default(cuid())
  question   String
  answer     String
  category   String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}
